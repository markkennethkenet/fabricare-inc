# Copy to .env and set your MySQL credentials
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=fabricare

# Hosted MySQL: use the provider's CA certificate for verified TLS.
# On Vercel, set MYSQL_SSL_CA_PEM to the full certificate, including newlines.
# Locally, MYSQL_SSL_CA can point to the downloaded CA certificate file.
MYSQL_SSL_CA=

HYBRID_ML_CONFIDENCE_THRESHOLD=85

# Google sign-in: optional. Leave unset to accept FabriCare's own web and Android client IDs
# (auth_routes.DEFAULT_GOOGLE_CLIENT_IDS). A comma-separated list replaces them; empty turns it off.
# GOOGLE_CLIENT_IDS=
