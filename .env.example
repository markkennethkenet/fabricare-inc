# Copy to .env and set your MySQL credentials
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=fabricare

# Hosted MySQL: use the provider's CA certificate for verified TLS.
# On Vercel, set MYSQL_SSL_CA_PEM to the full certificate, including newlines.
# Locally, MYSQL_SSL_CA can point to the downloaded CA certificate file.
MYSQL_SSL_CA=

HYBRID_ML_CONFIDENCE_THRESHOLD=85

# Google sign-in: optional. Leave unset to accept FabriCare's own web and Android client IDs
# (auth_routes.DEFAULT_GOOGLE_CLIENT_IDS). A comma-separated list replaces them; empty turns it off.
# GOOGLE_CLIENT_IDS=

# Optional demo sign-in (POST /auth/demo, accepted from localhost only). All three must be set.
# The app shows "Use demo code" only when built with --dart-define=FABRICARE_DEMO_SIGN_IN=true.
# FABRICARE_DEMO_CODE=choose-a-secret-code
# FABRICARE_DEMO_USER_ID=1
# FABRICARE_DEMO_EXPIRES_AT=never   # or a Unix time in milliseconds

# Optional: Gemini rewords the care advice for each scan (free tier for Flash models; Google may use
# free-tier requests to improve its products). Without a key the referenced rule tips are used.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_SEND_PHOTO=true
